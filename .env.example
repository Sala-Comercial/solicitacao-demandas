PORT=3000

# ClickUp
CLICKUP_API_TOKEN=your_clickup_api_token
CLICKUP_LIST_ID=your_clickup_list_id
CLICKUP_DEFAULT_STATUS=backlog
CLICKUP_TRANSCRIPTION_FIELD_ID=your_clickup_custom_field_id
# Campos customizados da lista Demandas
CLICKUP_AREA_FIELD_ID=19579c08-277c-4822-b130-f22ae71ab90f
CLICKUP_NAME_FIELD_ID=a56537b4-4b84-472b-a301-374624a6093f
CLICKUP_EMAIL_FIELD_ID=6d860a90-2704-4229-a387-7b54050e7647

# OpenAI (transcricao de audio via Whisper)
OPENAI_API_KEY=your_openai_api_key
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Correcao opcional do texto transcrito (pontuacao/clareza). true para ligar.
OPENAI_CLEANUP=false
OPENAI_CLEANUP_MODEL=gpt-4o-mini

# SASI (identificacao do solicitante quando o portal roda como canal URL)
# Nao existe token aqui: o token e de cada usuario e chega na requisicao.
SASI_API_BASE=https://api.sasi.io
# Nome do cookie/parametro em que a SASI entrega o token. Ajuste se for outro.
SASI_COOKIE_NAME=sasi-token
